{
  "name": "litegraph-fp",
  "version": "0.1.0",
  "description": "A headless, purely functional fork of litegraph.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx test.ts",
    "test:unit": "vitest run",
    "test:e2e": "tsx test.ts",
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "node scripts/dev_server.js",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "playwright": "^1.60.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.2"
  }
}
